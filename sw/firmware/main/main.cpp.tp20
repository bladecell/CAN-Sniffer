#define DEBUG_MODE 0

static const char *TAG = "APP_MAIN";
static LedError led(LED_GPIO);

esp_err_t setup_wifi()
{
    // Configure
    WIFI::Config config;
    config.ssid = "CAN-SNIFFER-AP";
    config.password = "";
    config.channel = 6;
    config.max_connections = 4;
    config.auth_mode = WIFI_AUTH_OPEN;
    config.mode = WIFI_MODE_STA;
    config.sta_ssid = WIFI_SSID;
    config.sta_password = WIFI_PASSWORD;
    config.sta_auth_mode = WIFI_AUTH_WPA2_PSK;

    esp_err_t ret = WIFI::getInstance().init(config);
    ret |= WIFI::getInstance().start();
    return ret;
}

esp_err_t setup_obd()
{
    CanDriver::Config config;

    // Settings::getInstance().getCanConfig(config);

    config.rx_pin = CAN_RX_GPIO;
    config.tx_pin = CAN_TX_GPIO;
    config.bitrate = CanDriver::Bitrate::BITRATE_500K;
    config.lbk_pin = CAN_LBK_GPIO;
    config.rs_pin = CAN_RS_GPIO;
    config.debug = DEBUG_MODE;

    esp_err_t ret = CanDriver::getInstance().init(config);

    vTaskDelay(pdMS_TO_TICKS(1000));
    if (ret != ESP_OK || !CanDriver::getInstance().isInitialized())
    {
        ESP_LOGE(TAG, "Failed to initialize CAN driver");
        return ret;
    }

    ESP_LOGI(TAG, "CAN driver initialized");

    // ret |= OBD2::getInstance().init();

    // vTaskDelay(pdMS_TO_TICKS(1000));

    // if (ret != ESP_OK)
    // {
    //     ESP_LOGE(TAG, "Failed to initialize OBD2 interface");
    //     return ret;
    // }

    // ESP_LOGI(TAG, "OBD2 interface initialized");
    return ESP_OK;
}
void t_request_sample(void *pvParameters)
{
    OBD2 &obd2 = OBD2::getInstance();

    vTaskDelay(pdMS_TO_TICKS(2000));
    for (;;)
    {
        if (!CanDriver::getInstance().isBusConnected() || !obd2.isPidInit())
        {
            ESP_LOGW(TAG, "CAN bus is not connected or PID not initialized");
            led.blink(1);
            vTaskDelay(pdMS_TO_TICKS(5000));
            continue;
        }
        break;
    }
    ESP_LOGI(TAG, "PID OK");

    obd2.requestConfirmedDTCs();
    vTaskDelay(pdMS_TO_TICKS(3000));
    std::vector<std::string> dtc = obd2.getDTC(MODE_DTCS);

    if (dtc.empty())
    {
        ESP_LOGI("DTC", "No DTC active");
    }
    else
    {
        std::string all_dtc;
        for (const auto &d : dtc)
        {
            if (!all_dtc.empty())
                all_dtc += ", ";
            all_dtc += d;
        }
        ESP_LOGI("DTC", "%s", all_dtc.c_str());
    }

    std::string vin;

    bool vinflag = false;

    obd2.startContinuousMode();
    vTaskDelay(pdMS_TO_TICKS(2000));
    for (;;)
    {
        if (!CanDriver::getInstance().isBusConnected() || !obd2.isPidInit())
        {
            ESP_LOGW(TAG, "CAN bus is not connected or PID not initialized");
            led.blink(1);
            vTaskDelay(pdMS_TO_TICKS(5000));
            continue;
        }
        else
        {
            led.off();
        }

        if (!vinflag)
        {
            obd2.requestVIN();
            ESP_LOGI(TAG, "Requesting VIN");
            vinflag = true;
        }

        if (!vin.empty())
        {
            ESP_LOGI("VIN", "%s", vin.c_str());
        }
        else
        {
            vin = obd2.getVIN();
        }

        float rpm = obd2.getValue(PID_ENGINE_RPM);
        float load = obd2.getValue(PID_ENGINE_LOAD);
        float temp = obd2.getValue(PID_COOLANT_TEMP);

        // Get the units for a more informative log
        const char *rpm_unit = obd2.getUnit(PID_ENGINE_RPM);
        const char *load_unit = obd2.getUnit(PID_ENGINE_LOAD);
        const char *temp_unit = obd2.getUnit(PID_COOLANT_TEMP);

        ESP_LOGI("Live Data", "RPM: %5.0f %s | Load: %6.2f %s | Temp: %3.0f %s",
                 rpm, rpm_unit,
                 load, load_unit,
                 temp, temp_unit);

        vTaskDelay(pdMS_TO_TICKS(1000));
    }
}

// ----- app_main --------------------------------------------------------------
extern "C" void app_main(void)
{
    vTaskDelay(pdMS_TO_TICKS(5000));
    esp_log_level_set("CAN_DRIVER", ESP_LOG_DEBUG);
    led.init();
    setup_obd();

    ESP_LOGI(TAG, "--- VW TP 2.0 FINAL ATTEMPT ---");

    while (!CanDriver::getInstance().isBusConnected())
        vTaskDelay(100);
    ESP_LOGI(TAG, "Connected!");

    uint16_t tx_id = 0;
    uint16_t rx_id = 0;

    // ==========================================================
    // PHASE 0: NEGOTIATION (ID 0x200)
    // ==========================================================
    uint8_t neg_req[] = {0x01, 0xC0, 0x00, 0x10, 0x00, 0x03, 0x01};
    twai_frame_t tx = {};
    tx.header.id = 0x200;
    tx.header.dlc = 7;
    tx.buffer = neg_req;
    tx.buffer_len = 7;

    CanDriver::getInstance().transmit(&tx, 100);

    // Wait for Negotiation Response (0xD0)
    bool negotiated = false;
    uint32_t start = esp_log_timestamp();
    while (esp_log_timestamp() - start < 1000)
    {
        CanDriver::CanFrame f{};
        if (CanDriver::getInstance().receive(f, pdMS_TO_TICKS(50)) == ESP_OK)
        {
            if ((f.id & 0xF00) == 0x200 && f.data[1] == 0xD0)
            {
                tx_id = 0x300 | f.data[4];
                rx_id = 0x300 | f.data[5];
                ESP_LOGI(TAG, "Negotiated! TX: 0x%X | RX: 0x%X", tx_id, rx_id);
                negotiated = true;
                break;
            }
        }
    }

    if (!negotiated)
    {
        ESP_LOGE(TAG, "Negotiation Failed");
        while (1)
            vTaskDelay(1000);
    }

    // ==========================================================
    // FLUSH BUFFER
    // ==========================================================
    CanDriver::getInstance().flushRxQueue();
    vTaskDelay(pdMS_TO_TICKS(50));

    // ==========================================================
    // PHASE 0.5: PARAMETER SETUP
    // ==========================================================
    uint8_t param_req[] = {0xA0, 0x0F, 0x8A, 0xFF, 0x32, 0xFF};
    tx.header.id = tx_id;
    tx.header.dlc = 6;
    tx.buffer = param_req;
    tx.buffer_len = 6;

    ESP_LOGI(TAG, "PHASE 0.5: Sending Parameters (0xA0)...");
    CanDriver::getInstance().transmit(&tx, 100);

    // Wait for Parameter ACK (0xA1)
    bool params_ok = false;
    start = esp_log_timestamp();
    while (esp_log_timestamp() - start < 1000)
    {
        CanDriver::CanFrame f{};
        if (CanDriver::getInstance().receive(f, pdMS_TO_TICKS(50)) == ESP_OK)
        {
            if (f.id == rx_id && f.data[0] == 0xA1)
            {
                ESP_LOGI(TAG, "Parameters Accepted (0xA1)!");
                params_ok = true;
                break;
            }
        }
    }

    if (!params_ok)
    {
        ESP_LOGW(TAG, "Warning: No Parameter ACK received");
    }

    // ==========================================================
    // PHASE 1: SESSION REQUEST
    // ==========================================================
    uint8_t session_seq = 0x00;
    uint8_t session_data[] = {session_seq, 0x02, 0x10, 0x03, 0x00, 0x00, 0x00, 0x00};

    tx.header.id = tx_id;
    tx.header.dlc = 8;
    tx.buffer = session_data;
    tx.buffer_len = 8;

    ESP_LOGI(TAG, "PHASE 1: Extended Session Request...");
    CanDriver::getInstance().transmit(&tx, 100);

    bool session_active = false;
    uint8_t received_seq = 0;
    start = esp_log_timestamp();

    while (esp_log_timestamp() - start < 1000)
    {
        CanDriver::CanFrame f{};
        if (CanDriver::getInstance().receive(f, pdMS_TO_TICKS(50)) == ESP_OK)
        {
            if (f.id == rx_id)
            {
                ESP_LOGI(TAG, "RX <- 0x%03X: [%02X %02X %02X %02X %02X %02X %02X %02X]",
                         f.id, f.data[0], f.data[1], f.data[2], f.data[3],
                         f.data[4], f.data[5], f.data[6], f.data[7]);

                // TP2.0 format: [SEQ][LEN][DATA...]
                received_seq = f.data[0];
                uint8_t len = f.data[1];

                // Check for positive response 0x50 (response to 0x10)
                if (f.data[2] == 0x50)
                {
                    session_active = true;
                    ESP_LOGI(TAG, ">>> Session Active! <<<");

                    // Send ACK (0xB0 + seq)
                    uint8_t ack[] = {(uint8_t)(0xB0 | received_seq), 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
                    tx.buffer = ack;
                    tx.buffer_len = 8;
                    tx.header.dlc = 8;
                    CanDriver::getInstance().transmit(&tx, 100);
                    ESP_LOGI(TAG, "Sent ACK: 0x%02X", ack[0]);
                    break;
                }
            }
        }
    }

    // ==========================================================
    // PHASE 2: ODOMETER READ
    // ==========================================================
    if (session_active)
    {
        vTaskDelay(pdMS_TO_TICKS(100));

        // Increment sequence number (rolls 0-15)
        uint8_t odo_seq = (session_seq + 1) & 0x0F;

        // Request: [SEQ][LEN][22][F4][A6]
        uint8_t odo_req[] = {odo_seq, 0x03, 0x22, 0xF4, 0xA6, 0x00, 0x00, 0x00};

        tx.buffer = odo_req;
        tx.buffer_len = 8;
        tx.header.dlc = 8;

        ESP_LOGI(TAG, "PHASE 2: Reading Odometer (DID 0xF4A6)...");
        CanDriver::getInstance().transmit(&tx, 100);

        start = esp_log_timestamp();
        while (esp_log_timestamp() - start < 2000)
        {
            CanDriver::CanFrame f{};
            if (CanDriver::getInstance().receive(f, pdMS_TO_TICKS(50)) == ESP_OK)
            {
                if (f.id == rx_id)
                {
                    ESP_LOGI(TAG, "RX <- 0x%03X: [%02X %02X %02X %02X %02X %02X %02X %02X]",
                             f.id, f.data[0], f.data[1], f.data[2], f.data[3],
                             f.data[4], f.data[5], f.data[6], f.data[7]);

                    received_seq = f.data[0];
                    uint8_t len = f.data[1];

                    // Check for positive response 0x62 (response to 0x22)
                    if (f.data[2] == 0x62)
                    {
                        // Response format: [SEQ][LEN][62][F4][A6][DATA0][DATA1][DATA2]
                        // But we need 4 bytes of data, might be multi-frame!

                        if (len == 0x07) // Single frame: 7 bytes = 62 + F4 + A6 + 4 data bytes
                        {
                            // Data starts at index 5
                            uint32_t rawValue = ((uint32_t)f.data[5] << 24) |
                                                ((uint32_t)f.data[6] << 16) |
                                                ((uint32_t)f.data[7] << 8);
                            // Missing 4th byte! Need to check if continued...

                            ESP_LOGI(TAG, "ODOMETER RAW (partial): %08X", rawValue);

                            // Send ACK
                            uint8_t ack[] = {(uint8_t)(0xB0 | received_seq), 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
                            tx.buffer = ack;
                            CanDriver::getInstance().transmit(&tx, 100);

                            // Apply formula: raw * 0.1
                            float odometerKm = rawValue * 0.1;
                            ESP_LOGI(TAG, ">>> ODOMETER: %.1f km <<<", odometerKm);
                        }
                        else if (len > 7)
                        {
                            ESP_LOGI(TAG, "Multi-frame response detected, len=%d", len);
                            // Need to wait for continuation frame...
                            // Store first 3 data bytes
                            uint8_t dataBuffer[16] = {0};
                            dataBuffer[0] = f.data[5];
                            dataBuffer[1] = f.data[6];
                            dataBuffer[2] = f.data[7];
                            int bytesReceived = 3;

                            // Send ACK to get next frame
                            uint8_t ack[] = {(uint8_t)(0xB0 | received_seq), 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
                            tx.buffer = ack;
                            CanDriver::getInstance().transmit(&tx, 100);

                            // Wait for continuation
                            uint32_t cont_start = esp_log_timestamp();
                            while (esp_log_timestamp() - cont_start < 500)
                            {
                                CanDriver::CanFrame cf{};
                                if (CanDriver::getInstance().receive(cf, pdMS_TO_TICKS(50)) == ESP_OK)
                                {
                                    if (cf.id == rx_id)
                                    {
                                        ESP_LOGI(TAG, "CONT <- [%02X %02X %02X %02X %02X %02X %02X %02X]",
                                                 cf.data[0], cf.data[1], cf.data[2], cf.data[3],
                                                 cf.data[4], cf.data[5], cf.data[6], cf.data[7]);

                                        // Continuation has format [SEQ][remaining data...]
                                        uint8_t cont_seq = cf.data[0];

                                        // Copy remaining bytes (starting from index 1)
                                        for (int i = 1; i < 8 && bytesReceived < len - 3; i++)
                                        {
                                            dataBuffer[bytesReceived++] = cf.data[i];
                                        }

                                        // Send ACK for continuation
                                        uint8_t cont_ack[] = {(uint8_t)(0xB0 | cont_seq), 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
                                        tx.buffer = cont_ack;
                                        CanDriver::getInstance().transmit(&tx, 100);

                                        if (bytesReceived >= 4)
                                        {
                                            uint32_t rawValue = ((uint32_t)dataBuffer[0] << 24) |
                                                                ((uint32_t)dataBuffer[1] << 16) |
                                                                ((uint32_t)dataBuffer[2] << 8) |
                                                                ((uint32_t)dataBuffer[3]);

                                            float odometerKm = rawValue * 0.1;
                                            ESP_LOGI(TAG, ">>> ODOMETER: %.1f km (raw: %u) <<<", odometerKm, rawValue);
                                            break;
                                        }
                                    }
                                }
                            }
                        }
                        break;
                    }
                    else if (f.data[2] == 0x7F) // Negative response
                    {
                        ESP_LOGE(TAG, "Negative Response! Service: 0x%02X, NRC: 0x%02X", f.data[3], f.data[4]);
                        break;
                    }
                }
            }
        }
    }

    ESP_LOGI(TAG, "Done.");
    while (1)
        vTaskDelay(1000);
}